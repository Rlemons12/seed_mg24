# Binding to 0.0.0.0 makes the dashboard reachable on the local network.
# Add authentication and TLS before exposing it outside a trusted LAN.
SEED_MG24_HOST=0.0.0.0
SEED_MG24_PORT=8000
SEED_MG24_DATABASE_URL=sqlite:///./data/seed_mg24.db
SEED_MG24_LOG_LEVEL=INFO
SEED_MG24_DEVICE_ID_PATTERN=^[A-Z0-9]+(?:-[A-Z0-9]+)*$
SEED_MG24_SCAN_DURATION_SECONDS=8
SEED_MG24_DISCOVERY_TTL_SECONDS=120
SEED_MG24_MAX_CONNECTION_ATTEMPTS=3
SEED_MG24_RECONNECT_INITIAL_SECONDS=1
SEED_MG24_RECONNECT_MAX_SECONDS=60
SEED_MG24_RECONNECT_STABLE_SECONDS=30
SEED_MG24_STALE_AFTER_SECONDS=30
SEED_MG24_POLL_INTERVAL_SECONDS=1
SEED_MG24_MAX_PAYLOAD_BYTES=2048
SEED_MG24_MAX_PAYLOAD_JSON_BYTES=4096
SEED_MG24_HISTORY_PAGE_SIZE_MAX=500
SEED_MG24_HISTORY_MAX_DAYS=31
SEED_MG24_SENSOR_PROFILE_DIRECTORY=./data/sensor_profiles
SEED_MG24_MAX_PROFILE_UPLOAD_BYTES=65536
SEED_MG24_PROVISIONING_TIMEOUT_SECONDS=10
# Optional absolute executable path when arduino-cli is not inherited through PATH.
SEED_MG24_ARDUINO_CLI=arduino-cli
# Development workstations only. Allows a loopback dashboard session to approve
# the catalog's fixed local artifact until the gateway process restarts.
SEED_MG24_DEVELOPER_FIRMWARE_APPROVAL=false
