# Binding to 0.0.0.0 makes the dashboard reachable on the local network.
# Add authentication and TLS before exposing it outside a trusted LAN.
SEED_MG24_HOST=0.0.0.0
SEED_MG24_PORT=8000
SEED_MG24_DATABASE_URL=sqlite:///./data/seed_mg24.db
SEED_MG24_LOG_LEVEL=INFO
SEED_MG24_DEVICE_ID_PATTERN=^[A-Z0-9]+(?:-[A-Z0-9]+)*$
SEED_MG24_SCAN_DURATION_SECONDS=8
SEED_MG24_DISCOVERY_TTL_SECONDS=120
SEED_MG24_MAX_CONNECTION_ATTEMPTS=3
SEED_MG24_RECONNECT_INITIAL_SECONDS=1
SEED_MG24_RECONNECT_MAX_SECONDS=60
SEED_MG24_RECONNECT_STABLE_SECONDS=30
SEED_MG24_STALE_AFTER_SECONDS=30
SEED_MG24_POLL_INTERVAL_SECONDS=1
SEED_MG24_MAX_PAYLOAD_BYTES=2048
SEED_MG24_MAX_PAYLOAD_JSON_BYTES=4096
SEED_MG24_HISTORY_PAGE_SIZE_MAX=500
SEED_MG24_HISTORY_MAX_DAYS=31
# Blank disables automatic deletion. When enabled, cleanup removes only readings
# older than this many days in bounded batches.
SEED_MG24_HISTORY_RETENTION_DAYS=
SEED_MG24_HISTORY_RETENTION_BATCH_SIZE=1000
# Relative vibration-condition monitoring. A baseline learns from this many
# valid windows, then freezes. History is persisted at the bounded cadence;
# every valid incoming window still participates in baseline/condition logic.
SEED_MG24_VIBRATION_BASELINE_MINIMUM_WINDOWS=100
SEED_MG24_VIBRATION_CONDITION_PERSISTENCE_WINDOWS=3
SEED_MG24_VIBRATION_PERSISTENCE_INTERVAL_SECONDS=5
# Charge detection and runtime-health heuristics. These are configurable
# observation policies, not validated battery chemistry or danger thresholds.
SEED_MG24_BATTERY_MINIMUM_VOLTAGE_RISE=0.12
SEED_MG24_BATTERY_VOLTAGE_NOISE_FLOOR=0.02
SEED_MG24_BATTERY_CHARGE_CONFIRMATION_SECONDS=120
SEED_MG24_BATTERY_CHARGE_MINIMUM_SAMPLES=3
SEED_MG24_BATTERY_STABLE_VOLTAGE_SECONDS=300
SEED_MG24_BATTERY_MAXIMUM_SAMPLE_GAP_SECONDS=900
SEED_MG24_BATTERY_BASELINE_MINIMUM_CYCLES=5
SEED_MG24_BATTERY_AGING_RUNTIME_RATIO=0.90
SEED_MG24_BATTERY_PLAN_REPLACEMENT_RUNTIME_RATIO=0.75
SEED_MG24_BATTERY_REPLACE_RUNTIME_RATIO=0.60
SEED_MG24_BATTERY_REQUIRED_DEGRADED_CYCLES=3
SEED_MG24_BATTERY_MAXIMUM_UNOBSERVED_RATIO=0.25
SEED_MG24_BATTERY_RECHARGE_WARNING_SECONDS=172800
SEED_MG24_BATTERY_TREND_LOOKBACK_CYCLES=6
SEED_MG24_BATTERY_ALERT_COOLDOWN_SECONDS=86400
# Limits battery state writes when high-rate telemetry repeats the same voltage channel.
SEED_MG24_BATTERY_PROCESSING_INTERVAL_SECONDS=5
# Provisional field thresholds for the specified unbranded 3.7 V LiPo; validate against the actual cell and load.
SEED_MG24_BATTERY_LOW_VOLTAGE_WARNING=3.5
SEED_MG24_BATTERY_LOW_VOLTAGE_CRITICAL=3.3
SEED_MG24_BATTERY_VOLTAGE_PREDICTION_MIN_DECLINE_PER_HOUR=0.002
# Optional UUID override for a newly initialized gateway. Once stored in SQLite,
# the gateway identity is immutable for that database.
SEED_MG24_GATEWAY_ID=
SEED_MG24_SENSOR_PROFILE_DIRECTORY=./data/sensor_profiles
SEED_MG24_MAX_PROFILE_UPLOAD_BYTES=65536
SEED_MG24_PROVISIONING_TIMEOUT_SECONDS=10
# Optional absolute executable path when arduino-cli is not inherited through PATH.
SEED_MG24_ARDUINO_CLI=arduino-cli
# Development workstations only. Allows a loopback dashboard session to approve
# the catalog's fixed local artifact until the gateway process restarts.
SEED_MG24_DEVELOPER_FIRMWARE_APPROVAL=false
