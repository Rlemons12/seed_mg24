{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seed-mg24.local/schemas/node_backup.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["backup_schema_version", "created_at_utc", "source_node_id", "identity_included", "state", "canonical_content_hash"],
  "properties": {
    "backup_schema_version": {"const": 1}, "created_at_utc": {"type": "string", "format": "date-time"},
    "source_node_id": {"type": ["string", "null"], "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$", "maxLength": 31},
    "identity_included": {"type": "boolean"}, "state": {"type": "object", "maxProperties": 32},
    "canonical_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
