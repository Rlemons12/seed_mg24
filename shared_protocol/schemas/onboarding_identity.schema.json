{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seed.local/schemas/onboarding_identity.schema.json",
  "title": "MG24 BLE onboarding identity",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "onboarding_identity", "provisioning_state", "protocol_version", "firmware_version"],
      "properties": {
        "schema_version": {"const": 1},
        "onboarding_identity": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "provisioning_state": {"enum": ["unprovisioned", "recovery"]},
        "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
        "firmware_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 64}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "provisioning_state", "protocol_version"],
      "properties": {
        "schema_version": {"const": 1},
        "provisioning_state": {"const": "provisioned"},
        "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32}
      }
    }
  ]
}
